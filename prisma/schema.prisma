generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String
  callsMade        Call[]         @relation("CallsMade")
  callsReceived    Call[]         @relation("CallsReceived")
  email            String         @unique
  password         String
  phone            String?
  avatar           String?
  role             Role           @default(USER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  cartItems        CartItem[]
  favorites        Favorite[]
  feedbacks        Feedback[]
  following        Follow[]       @relation("Followers")
  followers        Follow[]       @relation("Following")
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  notifications    Notification[]
  orders           Order[]        @relation("BuyerOrders")
  ordersAsSeller   Order[]        @relation("SellerOrders")
  ordersAsCourier  Order[]        @relation("CourierOrders")
  products         Product[]      @relation("SellerProducts")
  reels            Reel[]
  reelComments     ReelComment[]
  sellerReviewsReceived SellerReview[] @relation("SellerReviewsReceived")
  sellerReviewsGiven    SellerReview[] @relation("SellerReviewsGiven")
  shop             Shop?
  transactions     Transaction[]
  wallet           Wallet?
  payments         Payment[]
  walletDeposits   WalletDeposit[]
  walletWithdrawals WalletWithdrawal[]

  @@index([email])
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  verified    Boolean  @default(false)
  ownerId     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  imageBanner String?
  isActive    Boolean    @default(true)
  order       Int        @default(0)
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id             String       @id @default(cuid())
  title          String
  description    String
  priceUSD       Float        @default(0)
  priceCDF       Float        @default(0)
  quantity       Int          @default(1)
  state          ProductState @default(NEUF)
  type           ProductType  @default(SALE)
  images         String[]     @default([])
  videoUrl       String?
  qrCodeUrl      String?
  location       String?
  isSold         Boolean      @default(false)
  favoritesCount Int          @default(0)
  viewsCount     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  categoryId     String
  sellerId       String
  weight         Float?
  cartItems      CartItem[]
  favorites      Favorite[]
  orderItems     OrderItem[]
  category       Category     @relation(fields: [categoryId], references: [id])
  seller         User         @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  reel           Reel?
  reelViews      ReelView[]
  reelComments   ReelComment[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([type])
  @@index([isSold])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id              String        @id @default(cuid())
  buyerId         String
  sellerId        String? // renseigne pour les reservations rapides depuis un reel (1 seul produit/vendeur)
  totalUSD        Float         @default(0)
  totalCDF        Float         @default(0)
  status          OrderStatus   @default(PENDING)
  deliveryAddress String?
  expiresAt       DateTime? // fin du delai de 12h laisse au vendeur pour confirmer
  confirmedAt     DateTime? // horodatage de la confirmation du vendeur (statut CONFIRMED)
  courierId          String? // livreur CBFSOKO assigne par un admin pour cette collecte
  courierAssignedAt  DateTime? // horodatage de l'assignation manuelle par un admin (avant verification)
  verifiedAt         DateTime? // horodatage du passage en COURIER_VERIFIED (verification effective)
  verificationNote   String? // remarque libre du livreur (etat, conformite)
  verificationPhotos String[] @default([]) // photos prises par le livreur a la recuperation
  paidAt             DateTime? // horodatage de la confirmation du paiement (verifie aupres de WonyaPay)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller          User?         @relation("SellerOrders", fields: [sellerId], references: [id])
  courier         User?         @relation("CourierOrders", fields: [courierId], references: [id])
  items           OrderItem[]
  review          SellerReview?
  messages        Message[]
  payments        Payment[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([courierId])
  @@index([status, expiresAt])
}

