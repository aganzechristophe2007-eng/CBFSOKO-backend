model ReelView {
  id          String   @id @default(cuid())
  productId   String
  identityKey String // "user:<userId>" ou "visitor:<visitorId>"
  day         String // "YYYY-MM-DD" (UTC) : sert de fenÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Âªtre d'unicitÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â© quotidienne
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, identityKey, day])
  @@index([productId])
}

model ReelComment {
  id        String   @id @default(cuid())
  productId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId])
}


model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
model Message {
  id            String      @id @default(cuid())
  senderId      String
  receiverId    String
  type          MessageType @default(TEXT)
  content       String? // texte du message, ou lÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©gende optionnelle pour un mÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©dia
  mediaUrl      String? // URL sÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©curisÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©e Cloudinary (image, audio ou vidÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©o)
  mediaPublicId String? // public_id Cloudinary, nÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©cessaire pour une suppression future
  mediaDuration Int? // durÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©e en secondes (audio/vidÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©o)
  orderId       String? // renseignÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â© uniquement pour un message de type ORDER_REQUEST
  isRead        Boolean     @default(false)
  readAt        DateTime?
  createdAt     DateTime    @default(now())
  receiver      User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender        User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([receiverId, isRead])
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([orderId])
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  ORDER_REQUEST
}

model Call {
  id         String     @id @default(cuid())
  callerId   String
  receiverId String
  type       CallType
  status     CallStatus @default(MISSED)
  duration   Int        @default(0)
  createdAt  DateTime   @default(now())
  caller     User       @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  receiver   User       @relation("CallsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId, createdAt])
  @@index([receiverId, createdAt])
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  MISSED
  ANSWERED
  DECLINED
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Wallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  balanceUSD Float    @default(0)
  balanceCDF Float    @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  number     String?  @unique // numero public partageable, ex. CBF-12345678
}

model Transaction {
  id        String            @id @default(cuid())
  userId    String
  type      TransactionType
  amount    Float
  currency  String            @default("USD")
  status    TransactionStatus @default(PENDING)
  reference String?
  createdAt DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  counterpartyId String? // autre utilisateur d'un transfert
  orderId        String? // commande payee depuis le portefeuille

  @@unique([userId, reference])
  @@index([userId, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

