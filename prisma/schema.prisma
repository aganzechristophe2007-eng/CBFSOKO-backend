  USER
  COURIER // livreur CBFSOKO : rÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©cupÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¨re, vÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©rifie et expÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©die le produit aprÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¨s confirmation du vendeur
  ADMIN
  ADMIN_FINANCE
  SUPER_ADMIN
}

enum ProductType {
  SALE
  REQUEST
}

enum ProductState {
  NEUF
  OCCASION_BON_ETAT
  OCCASION_MOYEN
}

enum OrderStatus {
  PENDING
  AWAITING_SELLER_CONFIRMATION // reservation depuis un reel, en attente de confirmation du vendeur (12h max)
  CONFIRMED // le vendeur a valide la disponibilite ; un livreur CBFSOKO va recuperer et verifier l'article
  COURIER_VERIFIED // livreur passe sur place, article conforme (photos/etat) ; paiement securise debloque
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED // delai de 12h depasse sans reponse du vendeur, ou vendeur ayant signale le produit indisponible
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  TRANSFER_OUT
  TRANSFER_IN
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// ==========================================
// PAIEMENTS (WonyaPay, collecte Mobile Money C2B)
// ==========================================
enum PaymentStatus {
  PENDING // demande envoyee a WonyaPay, l'acheteur doit confirmer sur son telephone
  SUCCESS // paiement confirme par WonyaPay ET verifie cote serveur (jamais sur la seule foi d'un callback)
  FAILED // refuse, annule ou echoue (definitif)
  EXPIRED // delai depasse sans confirmation ; re-verifie pendant 24h au cas ou un paiement tardif aboutirait
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  userId                String
  refTransa             String        @unique // reference de 20 caracteres envoyee a WonyaPay, unique par tentative
  providerTransactionId String? // transactionId renvoye par WonyaPay a l'initiation
  amount                Float // montant demande (Montant), calcule cote serveur uniquement
  currency              String // CDF ou USD
  phoneMasked           String // numero Mobile Money masque (jamais stocke en clair)
  feeAmount             Float? // frais annonces par WonyaPay
  totalCharged          Float? // montantTotal annonce par WonyaPay
  network               String?
  status                PaymentStatus @default(PENDING)
  failureCode           String?
  refundRequired        Boolean       @default(false) // argent encaisse mais commande non payable : remboursement manuel a traiter
  lastCheckedAt         DateTime?
  confirmedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 Order         @relation(fields: [orderId], references: [id])
  user                  User          @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
  @@index([userId])
  @@index([status, createdAt])
}

enum WithdrawalStatus {
  PENDING // argent retenu, envoi vers Mobile Money en cours
  COMPLETED // confirme par WonyaPay
  FAILED // refuse ou echoue : l'argent a ete remis dans le portefeuille
}

model WalletDeposit {
  id                    String        @id @default(cuid())
  userId                String
  refTransa             String        @unique
  providerTransactionId String?
  amount                Float
  currency              String
  phoneMasked           String
  feeAmount             Float?
  totalCharged          Float?
  network               String?
  status                PaymentStatus @default(PENDING)
  failureCode           String?
  refundRequired        Boolean       @default(false)
  lastCheckedAt         DateTime?
  confirmedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model WalletWithdrawal {
  id                    String           @id @default(cuid())
  userId                String
  refTransa             String           @unique
  providerTransactionId String?
  amount                Float
  currency              String
  phoneMasked           String
  network               String?
  status                WithdrawalStatus @default(PENDING)
  failureCode           String?
  needsReview           Boolean          @default(false)
  lastCheckedAt         DateTime?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
