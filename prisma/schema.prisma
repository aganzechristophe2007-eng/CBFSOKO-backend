generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String
  callsMade        Call[]         @relation("CallsMade")
  callsReceived    Call[]         @relation("CallsReceived")
  email            String         @unique
  password         String
  phone            String?
  avatar           String?
  role             Role           @default(USER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  cartItems        CartItem[]
  favorites        Favorite[]
  feedbacks        Feedback[]
  following        Follow[]       @relation("Followers")
  followers        Follow[]       @relation("Following")
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  notifications    Notification[]
  orders           Order[]        @relation("BuyerOrders")
  ordersAsSeller   Order[]        @relation("SellerOrders")
  ordersAsCourier  Order[]        @relation("CourierOrders")
  products         Product[]      @relation("SellerProducts")
  reels            Reel[]
  reelComments     ReelComment[]
  sellerReviewsReceived SellerReview[] @relation("SellerReviewsReceived")
  sellerReviewsGiven    SellerReview[] @relation("SellerReviewsGiven")
  shop             Shop?
  transactions     Transaction[]
  wallet           Wallet?

  @@index([email])
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  verified    Boolean  @default(false)
  ownerId     String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  imageBanner String?
  isActive    Boolean    @default(true)
  order       Int        @default(0)
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id             String       @id @default(cuid())
  title          String
  description    String
  priceUSD       Float        @default(0)
  priceCDF       Float        @default(0)
  quantity       Int          @default(1)
  state          ProductState @default(NEUF)
  type           ProductType  @default(SALE)
  images         String[]     @default([])
  videoUrl       String?
  qrCodeUrl      String?
  location       String?
  isSold         Boolean      @default(false)
  favoritesCount Int          @default(0)
  viewsCount     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  categoryId     String
  sellerId       String
  weight         Float?
  cartItems      CartItem[]
  favorites      Favorite[]
  orderItems     OrderItem[]
  category       Category     @relation(fields: [categoryId], references: [id])
  seller         User         @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  reel           Reel?
  reelViews      ReelView[]
  reelComments   ReelComment[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([type])
  @@index([isSold])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id              String        @id @default(cuid())
  buyerId         String
  sellerId        String? // renseigne pour les reservations rapides depuis un reel (1 seul produit/vendeur)
  totalUSD        Float         @default(0)
  totalCDF        Float         @default(0)
  status          OrderStatus   @default(PENDING)
  deliveryAddress String?
  expiresAt       DateTime? // fin du delai de 12h laisse au vendeur pour confirmer
  confirmedAt     DateTime? // horodatage de la confirmation du vendeur (statut CONFIRMED)
  courierId          String? // livreur CBFSOKO ayant pris en charge la verification terrain
  verifiedAt         DateTime? // horodatage du passage en COURIER_VERIFIED
  verificationNote   String? // remarque libre du livreur (etat, conformite)
  verificationPhotos String[] @default([]) // photos prises par le livreur a la recuperation
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller          User?         @relation("SellerOrders", fields: [sellerId], references: [id])
  courier         User?         @relation("CourierOrders", fields: [courierId], references: [id])
  items           OrderItem[]
  review          SellerReview?
  messages        Message[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([courierId])
  @@index([status, expiresAt])
}

// Note du vendeur laissÃƒÆ’Ã‚Â©e par un acheteur. CrÃƒÆ’Ã‚Â©ÃƒÆ’Ã‚Â©e uniquement cÃƒÆ’Ã‚Â´tÃƒÆ’Ã‚Â© serveur
// aprÃƒÆ’Ã‚Â¨s vÃƒÆ’Ã‚Â©rification qu'une commande LIVRÃƒÆ’Ã¢â‚¬Â°E existe entre l'acheteur et ce
// vendeur (voir createSellerReview) : impossible de noter sans avoir achetÃƒÆ’Ã‚Â©.
model SellerReview {
  id        String   @id @default(cuid())
  sellerId  String
  buyerId   String
  orderId   String   @unique
  rating    Int // 1 ÃƒÆ’Ã‚Â  5, validÃƒÆ’Ã‚Â© cÃƒÆ’Ã‚Â´tÃƒÆ’Ã‚Â© serveur
  comment   String?
  createdAt DateTime @default(now())
  seller    User     @relation("SellerReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer     User     @relation("SellerReviewsGiven", fields: [buyerId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  priceUSD  Float
  priceCDF  Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Reel {
  id        String   @id @default(cuid())
  videoUrl  String
  thumbnail String?
  caption   String?
  productId String?  @unique
  sellerId  String
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id])
  seller    User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

// Une vue par identitÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© (utilisateur connectÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© OU visiteur anonyme) et par jour, pour un reel donnÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©.
// On s'appuie sur Product (et non sur le modÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¨le Reel) car c'est Product.id qui identifie
// rÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©ellement un reel cÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â´tÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© frontend (Home.tsx construit les reels ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â  partir des produits avec videoUrl).
model ReelView {
  id          String   @id @default(cuid())
  productId   String
  identityKey String // "user:<userId>" ou "visitor:<visitorId>"
  day         String // "YYYY-MM-DD" (UTC) : sert de fenÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Âªtre d'unicitÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â© quotidienne
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, identityKey, day])
  @@index([productId])
}

model ReelComment {
  id        String   @id @default(cuid())
  productId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([userId])
}


model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
model Message {
  id            String      @id @default(cuid())
  senderId      String
  receiverId    String
  type          MessageType @default(TEXT)
  content       String? // texte du message, ou lÃƒÂ©gende optionnelle pour un mÃƒÂ©dia
  mediaUrl      String? // URL sÃƒÂ©curisÃƒÂ©e Cloudinary (image, audio ou vidÃƒÂ©o)
  mediaPublicId String? // public_id Cloudinary, nÃƒÂ©cessaire pour une suppression future
  mediaDuration Int? // durÃƒÂ©e en secondes (audio/vidÃƒÂ©o)
  orderId       String? // renseignÃƒÂ© uniquement pour un message de type ORDER_REQUEST
  isRead        Boolean     @default(false)
  readAt        DateTime?
  createdAt     DateTime    @default(now())
  receiver      User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender        User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([receiverId, isRead])
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([orderId])
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  ORDER_REQUEST
}

model Call {
  id         String     @id @default(cuid())
  callerId   String
  receiverId String
  type       CallType
  status     CallStatus @default(MISSED)
  duration   Int        @default(0)
  createdAt  DateTime   @default(now())
  caller     User       @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  receiver   User       @relation("CallsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId, createdAt])
  @@index([receiverId, createdAt])
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  MISSED
  ANSWERED
  DECLINED
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Wallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  balanceUSD Float    @default(0)
  balanceCDF Float    @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String            @id @default(cuid())
  userId    String
  type      TransactionType
  amount    Float
  currency  String            @default("USD")
  status    TransactionStatus @default(PENDING)
  reference String?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  COURIER // livreur CBFSOKO : rÃ©cupÃ¨re, vÃ©rifie et expÃ©die le produit aprÃ¨s confirmation du vendeur
  ADMIN
  ADMIN_FINANCE
  SUPER_ADMIN
}

enum ProductType {
  SALE
  REQUEST
}

enum ProductState {
  NEUF
  OCCASION_BON_ETAT
  OCCASION_MOYEN
}

enum OrderStatus {
  PENDING
  AWAITING_SELLER_CONFIRMATION // reservation depuis un reel, en attente de confirmation du vendeur (12h max)
  CONFIRMED // le vendeur a valide la disponibilite ; un livreur CBFSOKO va recuperer et verifier l'article
  COURIER_VERIFIED // livreur passe sur place, article conforme (photos/etat) ; paiement securise debloque
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED // delai de 12h depasse sans reponse du vendeur, ou vendeur ayant signale le produit indisponible
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}
